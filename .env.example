# ─── Supabase Configuration ──────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
#
# Project URL (the base URL of your Supabase project)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
#
# Anon / Public key — safe for browser usage; access enforced by Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── External Image Upload Microservice ───────────────────────────────────────
# Base URL for the image upload microservice (Hugging Face Space)
IMAGE_UPLOAD_BASE_URL=https://omar280sa-we.hf.space
# Secret API Key for image upload service (starts with iu_). Stored strictly on backend!
IMAGE_UPLOAD_API_KEY=your-image-upload-api-key-here
